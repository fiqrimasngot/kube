---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: k8s-0
---
apiVersion: v1alpha1
kind: LinkAliasConfig
name: ethSel0
selector:
  match: glob("b4:2e:99:42:5b:e3", mac(link.hardware_addr))
---
apiVersion: v1alpha1
kind: Layer2VIPConfig
name: 10.32.1.10
link: ethSel0
---
apiVersion: v1alpha1
kind: LinkConfig
name: ethSel0
mtu: 1500
addresses:
  - address: 10.32.1.51/24
routes:
  - gateway: 10.32.1.1
---
apiVersion: v1alpha1
