  apiServer:
    image: registry.k8s.io/kube-apiserver:v1.35.2
    extraArgs:
      enable-aggregator-routing: "true"
    certSANs:
      - 127.0.0.1
      - 10.32.1.10
      - 100.69.20.97
      - k8s.fiqriha.kim
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata
  controllerManager:
