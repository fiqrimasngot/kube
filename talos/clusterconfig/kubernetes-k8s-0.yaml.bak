version: v1alpha1
debug: false
persist: true
machine:
  type: controlplane
  token: lus02h.8t68w4j3nxdo2rhz
  ca:
    crt: 
    key: LS0tLS1CRUdJTiBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0KTUM0Q0FRQXdCUVlESzJWd0JDSUVJTllYb1UvVS9KU2tsbjRHRFdIT1lWc1pCOWg3Mi9iTVB3emNqNzkyd1ZWRAotLS0tLUVORCBFRDI1NTE5IFBSSVZBVEUgS0VZLS0tLS0K
  certSANs:
    - 127.0.0.1
    - 10.32.1.10
    - 100.69.20.97
    - k8s.fiqriha.kim
  kubelet:
    image: ghcr.io/siderolabs/kubelet:v1.35.2
    extraConfig:
      maxPods: 250
      serializeImagePulls: false
    defaultRuntimeSeccompProfileEnabled: true
    nodeIP:
      validSubnets:
        - 10.32.1.0/24
    disableManifestsDirectory: true
  network:
    nameservers:
      - 1.1.1.1
      - 1.0.0.1
    disableSearchDomain: true
  install:
    disk: /dev/nvme0n1
    image: factory.talos.dev/installer/76c90c01a23d38ccbebb8b2359ac00ece51ac51ac9957d72c0d819aca4a647d7:v1.12.5
    wipe: false
    grubUseUKICmdline: true
  files:
    - content: |
        [plugins."io.containerd.cri.v1.images"]
          discard_unpacked_layers = false
        [plugins."io.containerd.cri.v1.runtime"]
          device_ownership_from_security_context = true
      permissions: 0o0
      path: /etc/cri/conf.d/20-customization.part
      op: create
  time:
    disabled: false
    servers:
      - 162.159.200.1
      - 162.159.200.123
  sysctls:
    fs.inotify.max_user_instances: "8192"
    fs.inotify.max_user_watches: "1048576"
    net.core.bpf_jit_harden: "1"
    net.core.rmem_max: "7500000"
    net.core.wmem_max: "7500000"
    net.ipv4.neigh.default.gc_thresh1: "4096"
    net.ipv4.neigh.default.gc_thresh2: "8192"
    net.ipv4.neigh.default.gc_thresh3: "16384"
    net.ipv4.tcp_slow_start_after_idle: "0"
    user.max_user_namespaces: "11255"
    vm.nr_hugepages: "1024"
  features:
    diskQuotaSupport: true
    kubePrism:
      enabled: true
      port: 7445
    hostDNS:
      enabled: true
      forwardKubeDNSToHost: true
  udev:
    rules:
      - SUBSYSTEM=="drm", KERNEL=="renderD*", GROUP="44", MODE="0660"
      - KERNEL=="uinput", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
  kernel:
    modules:
      - name: nvidia
      - name: nvidia_uvm
      - name: nvidia_drm
      - name: nvidia_modeset
      - name: nvme_tcp
      - name: vfio_pci
      - name: uinput
  nodeLabels:
    node.kubernetes.io/exclude-from-external-load-balancers: ""
cluster:
  id: bc6C5PkKhBXHrTkE3766r_sZ_utvX2x5t15KvwQ9P7s=
  secret: NnBA6p7DmtSZi4xgup/p71k3iIgbgsIYDkW1zu/GGYg=
  controlPlane:
    endpoint: https://10.32.1.10:6443
  clusterName: kubernetes
  network:
    cni:
      name: none
    dnsDomain: cluster.local
    podSubnets:
      - 10.42.0.0/16
    serviceSubnets:
      - 10.43.0.0/16
  token: jsygzr.r0jl50fz0m069itf
  secretboxEncryptionSecret: O3kTEncGhqfFy9HGL7e76Qo2u7bIgztQeKSkAMyTrKE=
  ca:
    crt: 
    key: 
  aggregatorCA:
    crt: 
    key: 
  serviceAccount:
