---
# yaml-language-server: $schema=https://raw.githubusercontent.com/fluxcd-community/flux2-schemas/main/helmrelease-helm-v2beta2.json
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: &app blender
spec:
  interval: 30m
  chartRef:
    kind: OCIRepository
    name: app-template
  maxHistory: 3
  install:
    remediation:
      retries: 5
  upgrade:
    remediation:
      retries: 5
  values:
    controllers:
      blender:
        replicas: 1
        containers:
          app:
            image:
              repository: lscr.io/linuxserver/blender
              tag: latest
            # env:
            #   VNCOPTIONS: "-disableBasicAuth"
            # resources:
            #   limits:
            #     memory: 10Gi
            #     cpu: 6000m
            #     nvidia.com/gpu: 1
            #   requests:
            #     cpu: 4000m
            #
        pod:
          runtimeClassName: nvidia
          affinity:
            nodeAffinity:
              requiredDuringSchedulingIgnoredDuringExecution:
                nodeSelectorTerms:
                  - matchExpressions:
                      - key: nvidia.feature.node.kubernetes.io/gpu
                        operator: In
                        values:
                          - "true"
    service:
      app:
        controller: blender
        type: LoadBalancer
        ports:
          https:
            port: &port 3000
    route:
      app:
        hostnames: ["blender.${SECRET_DOMAIN}"]
        parentRefs:
          - name: envoy-internal
            namespace: network
            sectionName: https
        rules:
          - backendRefs:
              - identifier: app
                port: *port
        annotations:
          gethomepage.dev/enabled: "true"
          gethomepage.dev/description: Blender
          gethomepage.dev/group: "{{ title .Release.Namespace }}"
          gethomepage.dev/name: "{{ title .Release.Name }}"
          gethomepage.dev/icon: "{{ .Release.Name }}"
          gethomepage.dev/siteMonitor: "http://{{ .Release.Name }}.{{ .Release.Namespace }}.svc.cluster.local:{{ index .Values \"service\" \"app\" \"ports\" \"https\" \"port\" }}"
    persistence:
      config:
        existingClaim: *app
