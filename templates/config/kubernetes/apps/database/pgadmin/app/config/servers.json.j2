{
  "Servers": {
    "1": {
      "Name": "postgis-rw",
      "Group": "Servers",
      "Host": "postgis-rw.database.svc.cluster.local",
      "Port": 5432,
      "MaintenanceDB": "postgis",
      "Username": "postgres",
      "SSLMode": "prefer",
      "SSLCert": "<STORAGE_DIR>/.postgresql/postgresql.crt",
      "SSLKey": "<STORAGE_DIR>/.postgresql/postgresql.key",
      "SSLCompression": 0,
      "Timeout": 10,
      "UseSSHTunnel": 0,
      "TunnelPort": "22",
      "TunnelAuthentication": 0
    }
  }
}
