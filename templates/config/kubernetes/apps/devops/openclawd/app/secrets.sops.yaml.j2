---
apiVersion: v1
kind: Secret
metadata:
    name: openclaw
stringData:
  OPENCLAW_GATEWAY_TOKEN: "#{ open_webui_client_id }#"
  DISCORD_BOT_TOKEN: "#{ open_webui_client_secret }#"
  ANTHROPIC_API_KEY: "#{ open_webui_redirect }#"
  GH_TOKEN: "https://chad.${SECRET_DOMAIN}/oauth/oidc/callback"
  openclaw.json: |
            {
              "agents": {
                "list": [
                  {
                    "id": "main",
                    "default": true,
                    "name": "Assistant",
                    "workspace": "/home/node/.openclaw/workspace"
                  },
                  {
                    "id": "coding",
                    "name": "Coder",
                    "workspace": "/home/node/.openclaw/workspace-coding",
                    "model": "gateway/auto-coding",
                    "tools": {
                      "allow": ["read", "write", "edit", "exec", "apply_patch", "browser"]
                    }
                  }
                ],
                "defaults": {
                  "model": { primary: "ollama/qwen3:8b" },
                  "models": {
                    "ollama/qwen3:8b": { alias: "qwen3:8b" },
                  }
                }
              },
              "auth": {
                "profiles": {
                  "ollama:default": {
                    "provider": "ollama",
                    "mode": "api_key"
                  }
                }
              },
              "models": {
                "providers": {
                  "ollama": {
                    "baseUrl": "http://ollama.devops.svc.cluster.local:11434/v1",
                    "apiKey": "ollama",
                    "api": "openai-responses",
                    "models": [
                      {
                        "id": "qwen3:8b",
                        "name": "DeepseekMini",
                        "reasoning": true,
                        "input": [
                          "text"
                        ],
                        "cost": {
                          "input": 0,
                          "output": 0,
                          "cacheRead": 0,
                          "cacheWrite": 0
                        },
                        "contextWindow": 131072,
                        "maxTokens": 8192
                      }
                    ]
                  }
                }
              },
              "gateway": {
                "mode": "local",
                "auth": {
                  "mode": "token",
                  "token": "#{ open_webui_client_id }#"
                },
                "trustedProxies": ["10.42.0.0/16", "10.43.0.0/16"]
              },
              bindings: [
                {
                  agentId: "main",
                  match: {
                    channel: "discord"
                  }
                }
              ],
              channels: {
                discord: {
                  enabled: true,
                  "token": "#{ discord_bot_token }#"
                  blockStreaming: true,
                  groupPolicy: "allowlist",
                  applicationId: "1472599068776595486",
                  guilds: {
                    "908919219519901766": {
                      requireMention: false,
                      channels: {
                        "908919219968675911": { allow: true }
                      }
                    }
                  }
                }
              },
              "tools": {
                "web": {
                  "search": {
                    "enabled": true,
                    "provider": "brave"
                  }
                }
              }
            }
