---
apiVersion: v1
kind: Secret
metadata:
    name: openclaw
stringData:
  OPENCLAW_GATEWAY_TOKEN: "#{ open_webui_client_id }#"
  DISCORD_BOT_TOKEN: "#{ open_webui_client_secret }#"
  ANTHROPIC_API_KEY: "#{ open_webui_redirect }#"
  GH_TOKEN: "https://chad.${SECRET_DOMAIN}/oauth/oidc/callback"
  openclaw.json: |
            {
              "agents": {
                "list": [
                  {
                    "id": "main",
                    "default": true,
                    "name": "Assistant",
                    "workspace": "/home/node/.openclaw/workspace"
                  },
                  {
                    "id": "coding",
                    "name": "Coder",
                    "workspace": "/home/node/.openclaw/workspace-coding",
                    "model": "gateway/auto-coding",
                    "tools": {
                      "allow": ["read", "write", "edit", "exec", "apply_patch", "browser"]
                    }
                  }
                ],
                "defaults": {
                  "model": {
                    "primary": "gateway/auto"
                  }
                }
              },
              "gateway": {
                "mode": "local",
                "auth": {
                  "mode": "token",
                  "token": "#{ open_webui_client_id }#"
                },
                "trustedProxies": ["10.42.0.0/16", "10.43.0.0/16"]
              },
              "tools": {
                "web": {
                  "search": {
                    "enabled": true,
                    "provider": "brave"
                  }
                }
              }
            }
