---
# yaml-language-server: $schema=https://raw.githubusercontent.com/fluxcd-community/flux2-schemas/main/helmrepository-source-v1.json
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: open-webui
spec:
  interval: 2h
  url: https://helm.openwebui.com/
---
# yaml-language-server: $schema=https://raw.githubusercontent.com/fluxcd-community/flux2-schemas/main/helmrelease-helm-v2.json
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: &app open-webui
spec:
  interval: 30m
  timeout: 15m
  chart:
    spec:
      chart: *app
      version: 8.19.0
      sourceRef:
        kind: HelmRepository
        name: *app
  install:
    remediation:
      retries: 3
  upgrade:
    cleanupOnFail: true
    remediation:
      retries: 3
  uninstall:
    keepHistory: false
  values:
    ollama:
      enabled: false
    # -- A list of Ollama API endpoints. These can be added in lieu of automatically installing the Ollama Helm chart, or in addition to it.
    # ollamaUrls: ["http://ollama.${EXTERNAL_DOMAIN}:11434"]
    ollamaUrls: ["http://ollama.devops.svc:11434"]
    # ollamaUrls: ["http://ollama.ai.svc:11434/api"]
    extraEnvVars:
      - name: ENABLE_LOGIN_FORM
        value: "false"
      - name: OAUTH_PROVIDER_NAME
        value: Authentik
      - name: ENABLE_OAUTH_SIGNUP
        value: "true"
      - name: OPENID_PROVIDER_URL
        valueFrom:
          secretKeyRef:
            name: *app
            key: OPENID_PROVIDER_URL
      - name: OAUTH_CLIENT_ID
        valueFrom:
          secretKeyRef:
            name: *app
            key: OAUTH_CLIENT_ID
      - name: OAUTH_CLIENT_SECRET
        valueFrom:
          secretKeyRef:
            name: *app
            key: OAUTH_CLIENT_SECRET
    persistence:
      enabled: true
      existingClaim: "ollama"
---
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: open-webui
  # annotations:
  #   external-dns.alpha.kubernetes.io/controller: none
spec:
  annotations:
      gethomepage.dev/enabled: "true"
      gethomepage.dev/group: "Home"
      gethomepage.dev/description: "AI Chat"
      gethomepage.dev/name: Open WebUI
      gethomepage.dev/icon: sh-open-webui
      gethomepage.dev/siteMonitor: "http://open-webui.devops.svc.cluster.local:80"
  hostnames:
    - "chad.${SECRET_DOMAIN}"
  parentRefs:
    - name: envoy-external
      namespace: network
  # rules:
  #   - backendRefs:
  #       - name: nextcloud
  #         namespace: devops
  #         port: 8080
