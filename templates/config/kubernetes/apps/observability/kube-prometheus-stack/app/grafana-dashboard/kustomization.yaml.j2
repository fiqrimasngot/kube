---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
configMapGenerator:
  - name: grafana-dashboard-nodes
    files:
      - pfsense.json
generatorOptions:
  disableNameSuffixHash: true
  labels:
    grafana-dashboard: 'true'
  annotations:
    k8s-sidecar-target-directory: /tmp/dashboards/Cluster
