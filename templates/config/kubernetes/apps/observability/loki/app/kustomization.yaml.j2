---
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - ./helmrelease.yaml
  - ./secrets.sops.yaml
configMapGenerator:
  - name: loki-rules
    namespace: observability
    files:
      - SyslogErrorRate.yaml=./alerts/syslog-errors.yaml
    options:
      labels:
        loki_rule: "true"
generatorOptions:
  disableNameSuffixHash: true
