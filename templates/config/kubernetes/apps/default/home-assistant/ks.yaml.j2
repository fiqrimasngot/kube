---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: home-assistant
spec:
  interval: 1h
  path: ./kubernetes/apps/default/home-assistant/app
  components:
    - ../../../../components/volsync
  postBuild:
    substitute:
      APP: home-assistant-pvc
      APP_UID: "0"
      APP_GID: "0"
      VOLSYNC_CAPACITY: 5Gi
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  targetNamespace: default
  wait: false
