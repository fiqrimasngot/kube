---
apiVersion: v1
kind: Secret
metadata:
    name: shlink
stringData:
    DB_NAME: &dbName shlink
    DB_HOST: &dbHost postgres-rw.database.svc.cluster.local
    DB_PORT: &dbPort "5432"
    DB_USER: &dbUser "#{ cloudnative_user }#"
    DB_PASSWORD: &dbPass "#{ cloudnative_password }#"
    GEOLITE_LICENSE_KEY: "#{ shlink_geolite_license_key }#"
    # Postgres Init
    INIT_POSTGRES_DBNAME: *dbName
    INIT_POSTGRES_HOST: *dbHost
    INIT_POSTGRES_USER: *dbUser
    INIT_POSTGRES_PASS: *dbPass
    INIT_POSTGRES_PORT: *dbPort
    INIT_POSTGRES_SUPER_PASS: *dbPass

