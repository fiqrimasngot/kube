---
# yaml-language-server: $schema=https://github.com/fluxcd-community/flux2-schemas/raw/main/helmrepository-source-v1beta2.json
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: longhorn
spec:
  interval: 1h
  url: https://charts.longhorn.io/
---
# yaml-language-server: $schema=https://kubernetes-schemas.pages.dev/helm.toolkit.fluxcd.io/helmrelease_v2.json
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: longhorn
spec:
  interval: 5m
  chart:
    spec:
      chart: longhorn
      version: 1.10.1
      interval: 10m
      sourceRef:
        kind: HelmRepository
        name: longhorn

  install:
    remediation:
      retries: 3
  upgrade:
    remediation:
      retries: 3

  values:
    persistence:
      defaultClass: false
      reclaimPolicy: Delete
      defaultClassReplicaCount: &replicas 1

    preUpgradeChecker.jobEnabled: false

    metrics:
      serviceMonitor:
        enabled: true

    ingress:
      enabled: true
      ingressClassName: "internal"
      annotations:
        gethomepage.dev/enabled: "true"
        gethomepage.dev/description: Storage system
        gethomepage.dev/group: Infrastructure
        gethomepage.dev/name: Longhorn
        gethomepage.dev/icon: sh-rancher-longhorn
        gethomepage.dev/pod-selector: "app=longhorn-ui"
      host: longhorn.${SECRET_DOMAIN}
      path: /

    defaultSettings:
      backupTarget: nfs://#{ nfs_svc }#:#{ nfs_mnt }#
      backupstorePollInterval: 300
      orphanAutoDeletion: true
      concurrentAutomaticEngineUpgradePerNodeLimit: 1
      defaultDataPath: /var/lib/longhorn
      defaultDataLocality: best-effort
      defaultLonghornStaticStorageClass: longhorn
      storageMinimalAvailablePercentage: "0"
      storageReservedPercentageForDefaultDisk: "0"
      nodeDownPodDeletionPolicy: delete-both-statefulset-and-deployment-pod
      allowRecurringJobWhileVolumeDetached: false
      autoCleanupSystemGeneratedSnapshot: true
      autoDeletePodWhenVolumeDetachedUnexpectedly: true
      disableSchedulingOnCordonedNode: true
      defaultReplicaCount: *replicas
      engineReplicaTimeout: 8
      deletingConfirmationFlag: false
      failedBackupTTL: 1440
      snapshotDataIntegrityImmediateCheckAfterSnapshotCreation: false
      snapshotDataIntegrityCronjob: 0 8 */7 * *
      upgradeChecker: false
      v2DataEngine: false
    #   taintToleration: node-role.kubernetes.io/control-plane:NoSchedule
    # longhornManager:
    #   tolerations: &tolerations
    #     - effect: NoSchedule
    #       key: node-role.kubernetes.io/control-plane
    #       operator: Exists
    # longhornDriver:
    #   tolerations: *tolerations
