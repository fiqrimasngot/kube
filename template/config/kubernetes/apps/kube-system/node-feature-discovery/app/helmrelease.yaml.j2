---
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: node-feature-discovery
  namespace: flux-system
spec:
  interval: 1h
  url: https://kubernetes-sigs.github.io/node-feature-discovery/charts
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: node-feature-discovery
spec:
  interval: 15m
  chart:
    spec:
      chart: node-feature-discovery
      version: 0.18.3
      sourceRef:
        kind: HelmRepository
        name: node-feature-discovery
      interval: 15m

  driftDetection:
    mode: enabled
  maxHistory: 3
  install:
    crds: CreateReplace
    remediation:
      retries: 3
  upgrade:
    crds: CreateReplace
    cleanupOnFail: true
    remediation:
      retries: 3

  # https://github.com/kubernetes-sigs/node-feature-discovery/blob/v0.15.1/deployment/helm/node-feature-discovery/values.yaml
  values:
    nodeFeatureRule:
      createCRD: true

    master:
      resources:
        requests:
          cpu: 21m
          memory: 64Mi
        limits:
          memory: 64Mi

    worker:
      config:
        core:
          sources: [ 'pci', 'system', 'usb' ]
        sources:
          usb:
            deviceClassWhitelist: [ '02', '03', '0e', 'ef', 'fe', 'ff' ]
            deviceLabelFields: [ 'class', 'vendor', 'device' ]

      resources:
        requests:
          cpu: 5m
          memory: 64Mi
        limits:
          memory: 64Mi

    prometheus:
      enable: true
