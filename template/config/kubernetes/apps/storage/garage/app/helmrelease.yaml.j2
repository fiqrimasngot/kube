---
# yaml-language-server: $schema=https://raw.githubusercontent.com/bjw-s-labs/helm-charts/main/charts/other/app-template/schemas/helmrelease-helm-v2.schema.json
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: &app garage
spec:
  interval: 30m
  timeout: 15m
  chartRef:
    kind: OCIRepository
    name: app-template
  install:
    remediation:
      retries: 3
  upgrade:
    cleanupOnFail: true
    remediation:
      strategy: rollback
      retries: 3
  values:
    controllers:
      garage:
        annotations:
          reloader.stakater.com/auto: "true"
        strategy: Recreate
        containers:
          app:
            image:
              repository: mirror.gcr.io/dxflrs/garage
              tag: v2.4.1@sha256:9c96caa2612d3411acc5b0e6701fb238dbfba33e533a6d7d3d811a4b12d0d020
            command:
              - /garage
              - server
              - --single-node
            env:
              GARAGE_CONFIG_FILE: /etc/garage/garage.toml
              GARAGE_ALLOW_WORLD_READABLE_SECRETS: "true"
            probes:
              liveness: &probes
                enabled: true
                custom: true
                spec:
                  tcpSocket:
                    port: 3900
                  initialDelaySeconds: 30
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 6
              readiness: *probes
            securityContext:
              allowPrivilegeEscalation: false
              readOnlyRootFilesystem: true
              capabilities: { drop: ["ALL"] }
            resources:
              requests:
                cpu: 100m
                memory: 256Mi
              limits:
                memory: 1Gi
    defaultPodOptions:
      securityContext:
        runAsNonRoot: true
        runAsUser: 568
        runAsGroup: 568
        fsGroup: 568
        fsGroupChangePolicy: OnRootMismatch
        supplementalGroups: [100]
        seccompProfile: { type: RuntimeDefault }
    service:
      app:
        controller: *app
        ports:
          s3:
            port: 3900
          rpc:
            port: 3901
          web:
            port: 3902
          admin:
            port: 3903
    persistence:
      config:
        type: configMap
        name: garage
        globalMounts:
          - path: /etc/garage/garage.toml
            subPath: garage.toml
            readOnly: true
      secrets:
        type: secret
        name: garage-secret
        globalMounts:
          - path: /etc/garage/secrets
            readOnly: true
      data:
        enabled: true
        existingClaim: backups
        globalMounts:
          - path: /var/lib/garage
            subPath: garage
    configMaps:
      config:
        data:
          garage.toml: |
            metadata_dir = "/var/lib/garage/meta"
            data_dir = "/var/lib/garage/data"
            db_engine = "sqlite"
            compression_level = 1
            replication_factor = 1
            rpc_bind_addr = "[::]:3901"
            rpc_public_addr = "garage.storage.svc.cluster.local:3901"
            rpc_secret_file = "/etc/garage/secrets/rpc-secret"

            [s3_api]
            s3_region = "garage"
            api_bind_addr = "[::]:3900"
            root_domain = ".s3-garage.${SECRET_DOMAIN}"

            [s3_web]
            bind_addr = "[::]:3902"
            root_domain = ".web-garage.${SECRET_DOMAIN}"

            [admin]
            api_bind_addr = "[::]:3903"
            admin_token_file = "/etc/garage/secrets/admin-token"
            metrics_token_file = "/etc/garage/secrets/metrics-token"
