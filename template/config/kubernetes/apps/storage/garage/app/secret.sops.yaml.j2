apiVersion: v1
kind: Secret
metadata:
    name: garage-secret
stringData:
    rpc-secret: "#{ garage.rpc_secret }#"
    admin-token: "#{ garage.admin_token }#"
    metrics-token: "#{ garage.metrics_token }#"
    default-access-key: "#{ garage.default_access_key }#"
    default-secret-key: "#{ garage.default_secret_key }#"
