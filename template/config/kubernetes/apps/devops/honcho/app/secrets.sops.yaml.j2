apiVersion: v1
kind: Secret
metadata:
  name: honcho
stringData:
  POSTGRES_DB: honcho
  POSTGRES_USER: honcho
  POSTGRES_PASSWORD: "#{ honcho.db_password | default(cloudnative.password) }#"
  DB_CONNECTION_URI: "postgresql+psycopg://honcho:#{ honcho.db_password | default(cloudnative.password) }#@honcho-postgres.devops.svc.cluster.local:5432/honcho"
