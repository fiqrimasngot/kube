apiVersion: v1
kind: Secret
metadata:
  name: honcho
stringData:
  INIT_POSTGRES_DBNAME: honcho
  INIT_POSTGRES_HOST: postgres-rw.database.svc.cluster.local
  INIT_POSTGRES_PORT: "5432"
  INIT_POSTGRES_USER: honcho
  INIT_POSTGRES_PASS: "#{ honcho.db_password | default(cloudnative.password) }#"
  INIT_POSTGRES_SUPER_USER: "#{ cloudnative.username }#"
  INIT_POSTGRES_SUPER_PASS: "#{ cloudnative.password }#"
  DB_CONNECTION_URI: "postgresql+psycopg://honcho:#{ honcho.db_password | default(cloudnative.password) }#@postgres-rw.database.svc.cluster.local:5432/honcho"
