---
apiVersion: v1
kind: Secret
metadata:
    name: actions-runner-controller-auth-secrets
stringData:
  ACTION_RUNNER_CONTROLLER_GITHUB_APP_ID: |-
    #{ github_runner.app_id }#
  ACTION_RUNNER_CONTROLLER_GITHUB_INSTALLATION_ID: |-
    #{ github_runner.installation_id }#
  ACTION_RUNNER_CONTROLLER_GITHUB_WEBHOOK_SECRET_TOKEN: |-
    #{ github_runner.webhook_secret_token }#
  ACTION_RUNNER_CONTROLLER_GITHUB_PRIVATE_KEY: |
    #% filter indent(width=4, first=False) %#
    #{ github_runner.private_key }#
    #%- endfilter %#

