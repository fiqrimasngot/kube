# Adapted from blackjid/home-ops: kubernetes/apps/ai/hermes/app/helmrelease.yaml
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: hermes
  namespace: devops
spec:
  chartRef:
    kind: OCIRepository
    name: hermes
  interval: 1h
  values:
    controllers:
      hermes:
        annotations:
          reloader.stakater.com/auto: 'true'
        strategy: Recreate
        pod:
          automountServiceAccountToken: true
        serviceAccount:
          name: hermes
        containers:
          app:
            image: &id002
              repository: nousresearch/hermes-agent
              tag: v2026.9.24@sha256:fca358f12efd65bfaaca05884166f15c0e2788375ca30d77061ac1ebc96452b7
            command:
            - hermes
            - gateway
            - run
            env:
              API_SERVER_ENABLED: 'true'
              API_SERVER_HOST: 0.0.0.0
              API_SERVER_PORT: 8642
              HERMES_HOME: /opt/data
              HOME: /opt/data
              PATH: /opt/hermes/.venv/bin:/opt/data/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
              TZ: ${TIMEZONE}
              API_SERVER_MODEL_NAME: hermes-agent
            envFrom:
            - secretRef:
                name: '{{ .Release.Name }}-secret'
            probes:
              liveness: &id001
                enabled: true
                custom: true
                spec:
                  tcpSocket:
                    port: 8642
                  initialDelaySeconds: 30
                  periodSeconds: 30
                  timeoutSeconds: 5
                  failureThreshold: 5
              readiness: *id001
              startup:
                enabled: true
                custom: true
                spec:
                  tcpSocket:
                    port: 8642
                  initialDelaySeconds: 10
                  periodSeconds: 10
                  failureThreshold: 30
            resources:
              requests:
                cpu: 100m
                memory: 512Mi
              limits:
                memory: 2Gi
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                drop:
                - ALL
          dashboard:
            image: *id002
            env:
              GATEWAY_HEALTH_URL: http://localhost:8642
              TZ: ${TIMEZONE}
              HOME: /opt/data
              HERMES_HOME: /opt/data
              PATH: /opt/hermes/.venv/bin:/opt/data/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
            envFrom:
            - secretRef:
                name: '{{ .Release.Name }}-secret'
            resources:
              requests:
                cpu: 50m
                memory: 128Mi
              limits:
                memory: 1Gi
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                drop:
                - ALL
            command:
            - hermes
            - dashboard
            - --host
            - 0.0.0.0
            - --port
            - '9119'
            - --no-open
            probes:
              readiness:
                enabled: true
                custom: true
                spec:
                  tcpSocket:
                    port: 9119
                  periodSeconds: 10
                  timeoutSeconds: 5
              startup:
                enabled: true
                custom: true
                spec:
                  tcpSocket:
                    port: 9119
                  periodSeconds: 10
                  failureThreshold: 30
        initContainers:
          seed-config:
            image:
              repository: nousresearch/hermes-agent
              tag: v2026.9.24@sha256:fca358f12efd65bfaaca05884166f15c0e2788375ca30d77061ac1ebc96452b7
            command:
            - python
            - -c
            - from pathlib import Path; import shutil; home=Path('/opt/data'); home.mkdir(parents=True,
              exist_ok=True); (home/'workspace').mkdir(exist_ok=True); target=home/'config.yaml';
              shutil.copyfile('/bootstrap/config.yaml', target) if not target.exists()
              else None
            securityContext:
              allowPrivilegeEscalation: false
              capabilities:
                drop:
                - ALL
    defaultPodOptions:
      securityContext:
        runAsUser: 10000
        runAsGroup: 10000
        fsGroup: 10000
        fsGroupChangePolicy: OnRootMismatch
        runAsNonRoot: true
    serviceAccount:
      hermes: {}
    rbac:
      roles:
        hermes-cluster:
          type: ClusterRole
          rules:
          - apiGroups:
            - ''
            resources:
            - pods
            - pods/log
            - nodes
            - services
            - namespaces
            - configmaps
            - persistentvolumes
            - persistentvolumeclaims
            - endpoints
            - serviceaccounts
            - events
            verbs:
            - get
            - list
            - watch
          - apiGroups:
            - apps
            resources:
            - deployments
            - daemonsets
            - statefulsets
            - replicasets
            - controllerrevisions
            verbs:
            - get
            - list
            - watch
          - apiGroups:
            - batch
            resources:
            - jobs
            - cronjobs
            verbs:
            - get
            - list
            - watch
          - apiGroups:
            - networking.k8s.io
            resources:
            - ingresses
            - ingressclasses
            - networkpolicies
            verbs:
            - get
            - list
            - watch
          - apiGroups:
            - storage.k8s.io
            resources:
            - storageclasses
            - csinodes
            - csidrivers
            - volumeattachments
            verbs:
            - get
            - list
            - watch
          - apiGroups:
            - autoscaling
            resources:
            - horizontalpodautoscalers
            verbs:
            - get
            - list
            - watch
          - apiGroups:
            - policy
            resources:
            - poddisruptionbudgets
            verbs:
            - get
            - list
            - watch
          - apiGroups:
            - rbac.authorization.k8s.io
            resources:
            - roles
            - rolebindings
            - clusterroles
            - clusterrolebindings
            verbs:
            - get
            - list
            - watch
          - apiGroups:
            - metrics.k8s.io
            resources:
            - nodes
            - pods
            verbs:
            - get
            - list
            - watch
          - apiGroups:
            - helm.toolkit.fluxcd.io
            resources:
            - helmreleases
            verbs:
            - get
            - list
            - watch
          - apiGroups:
            - kustomize.toolkit.fluxcd.io
            resources:
            - kustomizations
            verbs:
            - get
            - list
            - watch
          - apiGroups:
            - source.toolkit.fluxcd.io
            resources:
            - gitrepositories
            - helmrepositories
            - ocirepositories
            - buckets
            - helmcharts
            verbs:
            - get
            - list
            - watch
      bindings:
        hermes-cluster:
          type: ClusterRoleBinding
          roleRef:
            kind: ClusterRole
            identifier: hermes-cluster
          subjects:
          - kind: ServiceAccount
            identifier: hermes
    service:
      app:
        controller: hermes
        ports:
          dashboard:
            port: 9119
          gateway:
            port: 8642
    route:
      app:
        hostnames:
        - hermes.${SECRET_DOMAIN}
        parentRefs:
        - name: envoy-external
          namespace: network
          sectionName: https
        rules:
        - backendRefs:
          - identifier: app
            port: 9119
        annotations:
          gethomepage.dev/enabled: 'true'
          gethomepage.dev/name: Hermes
          gethomepage.dev/group: AI
          gethomepage.dev/description: AI agent and chat dashboard
    persistence:
      data:
        existingClaim: '{{ .Release.Name }}'
        globalMounts:
        - path: /opt/data
      tmp:
        type: emptyDir
        globalMounts:
        - path: /tmp
      bootstrap:
        type: configMap
        identifier: bootstrap
        advancedMounts:
          hermes:
            seed-config:
            - path: /bootstrap
              readOnly: true
    configMaps:
      bootstrap:
        data:
          config.yaml: "terminal:\n  backend: local\n  cwd: /opt/data/workspace\n\
            dashboard:\n  public_url: https://hermes.${SECRET_DOMAIN}\n"
  timeout: 10m
  install:
    remediation:
      retries: 3
  upgrade:
    cleanupOnFail: true
    remediation:
      retries: 3
