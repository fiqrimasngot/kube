---
# yaml-language-server: $schema=https://json.schemastore.org/kustomization
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - ./secret.sops.yaml
  - ./helmrelease.yaml
  - ./ocirepository.yaml
configMapGenerator:
  - name: hermes-configmap
    files:
      - config.yaml=./resources/config.yaml
      - kanban-status-whatsapp.py=./resources/kanban-status-whatsapp.py
      - profile-automationops.yaml=./resources/profile-automationops.yaml
      - profile-kubeimplementer.yaml=./resources/profile-kubeimplementer.yaml
      - profile-researcher.yaml=./resources/profile-researcher.yaml
      - profile-reviewer.yaml=./resources/profile-reviewer.yaml
generatorOptions:
  disableNameSuffixHash: true
  annotations:
    kustomize.toolkit.fluxcd.io/substitute: disabled
