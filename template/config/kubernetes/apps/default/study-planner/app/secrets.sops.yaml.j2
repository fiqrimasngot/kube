---
apiVersion: v1
kind: Secret
metadata:
  name: study-planner
stringData:
  DB_NAME: &dbName study_planner
  DB_HOST: &dbHost postgres-rw.database.svc.cluster.local
  DB_PORT: &dbPort "5432"
  DB_USER: &dbUser "#{ cloudnative.username }#"
  DB_PASSWORD: &dbPass "#{ cloudnative.password }#"
  INIT_POSTGRES_DBNAME: *dbName
  INIT_POSTGRES_HOST: *dbHost
  INIT_POSTGRES_PORT: *dbPort
  INIT_POSTGRES_USER: *dbUser
  INIT_POSTGRES_PASS: *dbPass
  INIT_POSTGRES_SUPER_PASS: "#{ cloudnative.password }#"