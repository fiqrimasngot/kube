---
apiVersion: v1
kind: ConfigMap
metadata:
  name: study-planner
  labels:
    app.kubernetes.io/name: study-planner
data:
  default.conf: |
    server {
      listen 8080;
      server_name _;
      root /usr/share/nginx/html;
      location /api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      }
      location / { try_files $uri /index.html; }
    }
  index.html: |
    <!doctype html>
    <html lang="en">
    <head>
      <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
      <title>Study Planner</title>
      <style>
        :root{color-scheme:dark;font-family:Inter,system-ui,sans-serif;background:#111827;color:#f3f4f6}*{box-sizing:border-box}body{margin:0;background:linear-gradient(135deg,#111827,#1f2937);min-height:100vh}.wrap{max-width:1050px;margin:auto;padding:28px 18px}h1{margin:0 0 6px;font-size:clamp(2rem,5vw,3.5rem)}p{color:#9ca3af}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:24px}.card{background:#1f2937cc;border:1px solid #374151;border-radius:18px;padding:20px;box-shadow:0 10px 30px #0003}.form{display:grid;gap:10px}.form input,.form textarea,.form button{font:inherit;padding:11px;border-radius:10px;border:1px solid #4b5563;background:#111827;color:#fff}.form textarea{min-height:70px;resize:vertical}.form button,.complete{background:#2563eb;border:0;cursor:pointer}.form button:disabled{opacity:.6;cursor:wait}.stats{display:flex;gap:10px;flex-wrap:wrap}.stat{background:#111827;border-radius:12px;padding:12px 15px;min-width:110px}.stat b{display:block;font-size:1.4rem;color:#60a5fa}.task,.reminder{display:flex;gap:10px;align-items:flex-start;border-bottom:1px solid #374151;padding:12px 0}.task:last-child,.reminder:last-child{border:0}.task.done span,.reminder.done .reminder-title{text-decoration:line-through;color:#6b7280}.task button,.reminder button{margin-left:auto;background:transparent;color:#f87171;border:0;cursor:pointer}.reminder.overdue{border-left:4px solid #f87171;padding-left:8px}.reminder-actions{display:flex;gap:8px;margin-left:auto}.reminder-actions button{margin:0;color:#93c5fd}.empty{text-align:center;color:#9ca3af;padding:24px}.error{color:#fca5a5;min-height:1.2em}.week{display:grid;grid-template-columns:repeat(7,1fr);gap:8px;margin-top:18px}.day{background:#111827;border-radius:10px;padding:10px;min-height:80px}.day small{color:#9ca3af}.day strong{display:block;margin-top:8px}@media(max-width:700px){.grid{grid-template-columns:1fr}.week{grid-template-columns:repeat(2,1fr)}}
      </style>
    </head>
    <body><main class="wrap"><h1>Study Planner</h1><p>Plan sessions and keep shared reminders in one place.</p>
      <section class="stats"><div class="stat"><b id="total">0</b>Total tasks</div><div class="stat"><b id="done">0</b>Completed</div><div class="stat"><b id="hours">0</b>Planned hours</div></section>
      <div class="grid"><section class="card"><h2>Add a study task</h2><form class="form" id="task-form"><input id="title" required placeholder="e.g. Revise algebra"><input id="subject" placeholder="Subject"><input id="date" type="date" required><input id="duration" type="number" min="0.25" step="0.25" value="1" placeholder="Hours"><button>Add task</button></form><div id="week" class="week"></div></section>
      <section class="card"><h2>Task list</h2><div id="tasks"></div></section>
      <section class="card"><h2>Shared reminders</h2><p>Reminders are shared with other people using this planner.</p><form class="form" id="reminder-form"><input id="reminder-title" required placeholder="Reminder title"><textarea id="reminder-details" placeholder="Details (optional)"></textarea><input id="reminder-at" type="datetime-local"><button id="reminder-submit">Add reminder</button></form><div id="reminder-error" class="error" role="alert"></div><div id="reminders" aria-live="polite"><div class="empty">Loading reminders…</div></div></section></div>
    </main><script>
      const $=id=>document.getElementById(id);const taskKey='study-planner-tasks';let tasks=JSON.parse(localStorage.getItem(taskKey)||'[]'), reminders=[], editingId=null;
      const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
      function renderTasks(){let complete=tasks.filter(t=>t.done);$('total').textContent=tasks.length;$('done').textContent=complete.length;$('hours').textContent=tasks.reduce((n,t)=>n+t.duration,0).toFixed(2);$('tasks').innerHTML=tasks.length?tasks.slice().sort((a,b)=>a.date.localeCompare(b.date)).map(t=>`<div class="task $${t.done?'done':''}"><input type="checkbox" $${t.done?'checked':''} onchange="toggleTask($${t.id})"><span><b>$${esc(t.title)}</b><br><small>$${esc(t.subject||'General')} · $${esc(t.date)} · $${t.duration}h</small></span><button onclick="removeTask($${t.id})">Delete</button></div>`).join(''):'<div class="empty">No tasks yet. Add your first study session.</div>';let now=new Date(),start=new Date(now);start.setDate(now.getDate()-((now.getDay()+6)%7));$('week').innerHTML=Array.from({length:7},(_,i)=>{let d=new Date(start);d.setDate(start.getDate()+i);let s=d.toISOString().slice(0,10),n=tasks.filter(t=>t.date===s).length;return `<div class="day"><small>$${d.toLocaleDateString(undefined,{weekday:'short'})}</small><strong>$${n} task$${n===1?'':'s'}</strong></div>`}).join('')}
      function saveTasks(){localStorage.setItem(taskKey,JSON.stringify(tasks));renderTasks()}function toggleTask(id){let t=tasks.find(x=>x.id===id);if(t){t.done=!t.done;saveTasks()}}function removeTask(id){tasks=tasks.filter(x=>x.id!==id);saveTasks()}
      $('task-form').onsubmit=e=>{e.preventDefault();tasks.push({id:Date.now(),title:$('title').value,subject:$('subject').value,date:$('date').value,duration:+$('duration').value||0,done:false});e.target.reset();$('duration').value=1;saveTasks()};
      async function api(path,options={}){let r=await fetch(path,{headers:{'Content-Type':'application/json',...(options.headers||{})},...options});if(!r.ok){let x=await r.json().catch(()=>({}));throw Error(x.error?.message||`Request failed ($${r.status})`)}return r.status===204?null:r.json()}
      function formatDate(s){return s?new Date(s).toLocaleString():'No date'}
      function renderReminders(){let now=Date.now();$('reminders').innerHTML=reminders.length?reminders.map(r=>{let overdue=!r.completed&&r.remind_at&&new Date(r.remind_at).getTime()<=now;return `<div class="reminder $${r.completed?'done':''} $${overdue?'overdue':''}"><input type="checkbox" $${r.completed?'checked':''} onchange="toggleReminder('$${r.id}',$${!r.completed})"><div><div class="reminder-title"><b>$${esc(r.title)}</b></div><small>$${esc(r.details||'')} · $${esc(formatDate(r.remind_at))}</small></div><div class="reminder-actions"><button onclick="editReminder('$${r.id}')">Edit</button><button onclick="deleteReminder('$${r.id}')">Delete</button></div></div>`}).join(''):'<div class="empty">No reminders yet.</div>'}
      async function loadReminders(){try{let response=await fetch('/api/reminders');if(!response.ok){let x=await response.json().catch(()=>({}));throw Error(x.error?.message||`Request failed ($${response.status})`)}reminders=await response.json();renderReminders();$('reminder-error').textContent=''}catch(e){$('reminder-error').textContent=e.message;$('reminders').innerHTML='<div class="empty">Reminders are temporarily unavailable.</div>'}}
      $('reminder-form').onsubmit=async e=>{e.preventDefault();let body={title:$('reminder-title').value,details:$('reminder-details').value||null,remind_at:$('reminder-at').value?new Date($('reminder-at').value).toISOString():null};$('reminder-submit').disabled=true;try{if(editingId){await api('/api/reminders/'+editingId,{method:'PATCH',body:JSON.stringify(body)});editingId=null;$('reminder-submit').textContent='Add reminder'}else await api('/api/reminders',{method:'POST',body:JSON.stringify(body)});e.target.reset();await loadReminders()}catch(err){$('reminder-error').textContent=err.message}finally{$('reminder-submit').disabled=false}};
      function editReminder(id){let r=reminders.find(x=>x.id===id);if(!r)return;editingId=id;$('reminder-title').value=r.title;$('reminder-details').value=r.details||'';$('reminder-at').value=r.remind_at?new Date(r.remind_at).toISOString().slice(0,16):'';$('reminder-submit').textContent='Save reminder';$('reminder-title').focus()}
      async function toggleReminder(id,completed){try{await api('/api/reminders/'+id,{method:'PATCH',body:JSON.stringify({completed})});await loadReminders()}catch(e){$('reminder-error').textContent=e.message}}
      async function deleteReminder(id){if(!confirm('Delete this reminder?'))return;try{await api('/api/reminders/'+id,{method:'DELETE'});await loadReminders()}catch(e){$('reminder-error').textContent=e.message}}
      renderTasks();loadReminders();
    </script></body></html>
