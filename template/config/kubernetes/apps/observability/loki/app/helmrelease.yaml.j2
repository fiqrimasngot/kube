---
# yaml-language-server: $schema=https://kubernetes-schemas.pages.dev/source.toolkit.fluxcd.io/helmrepository_v1.json
apiVersion: source.toolkit.fluxcd.io/v1
kind: HelmRepository
metadata:
  name: grafana
spec:
  interval: 2h
  url: https://grafana.github.io/helm-charts
---
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: &app loki
spec:
  interval: 30m
  timeout: 15m
  chart:
    spec:
      chart: loki
      version: 6.49.0
      sourceRef:
        kind: HelmRepository
        name: grafana
  maxHistory: 2
  install:
    remediation:
      retries: 3
  upgrade:
    cleanupOnFail: true
    remediation:
      retries: 3
  uninstall:
    keepHistory: false
  values:
    deploymentMode: SimpleScalable

    loki:
      auth_enabled: false

      analytics:
        reporting_enabled: false

      compactor:
        working_directory: /var/loki/compactor/retention
        delete_request_store: s3
        retention_enabled: true

      frontend:
        max_outstanding_per_tenant: 4096

      ingester:
        chunk_encoding: snappy

      commonConfig:
        replication_factor: 1

      limits_config:
        ingestion_burst_size_mb: 128
        ingestion_rate_mb: 64
        max_query_parallelism: 100
        per_stream_rate_limit: 64M
        per_stream_rate_limit_burst: 128M
        reject_old_samples: true
        reject_old_samples_max_age: 48h
        retention_period: 2d
        shard_streams:
          enabled: true
        split_queries_by_interval: 1h

      query_scheduler:
        max_outstanding_requests_per_tenant: 4096

      rulerConfig:
        enable_api: true
        enable_alertmanager_v2: true
        alertmanager_url: http://kube-prometheus-stack-alertmanager.observability.svc.cluster.local:9093
        storage:
          type: local
          local:
            directory: /rules
        rule_path: /rules/fake

      schemaConfig:
        configs:
          - from: "2024-04-01"
            store: tsdb
            object_store: s3
            schema: v13
            index:
              prefix: loki_index_
              period: 24h

      server:
        log_level: info
        grpc_server_max_recv_msg_size: 8388608
        grpc_server_max_send_msg_size: 8388608

      storage:
        type: s3
        bucketNames:
          chunks: loki-chunks
          ruler: loki-ruler
          admin: loki-admin
        s3:
          s3ForcePathStyle: true
          region: my
          insecure: false

    gateway:
      replicas: 1
      enabled: true
      image:
        registry: ghcr.io
        repository: nginxinc/nginx-unprivileged
        tag: 1.27.4-alpine
      deploymentStrategy:
        type: RollingUpdate
        rollingUpdate:
          maxUnavailable: 50%
          maxSurge: 50%
      # topologySpreadConstraints:
      #   - maxSkew: 1
      #     topologyKey: kubernetes.io/hostname
      #     whenUnsatisfiable: DoNotSchedule
      #     labelSelector:
      #       matchLabels:
      #         app.kubernetes.io/name: loki
      #         app.kubernetes.io/component: gateway

      ingress:
        enabled: true
        ingressClassName: "internal"
        annotations:
          gethomepage.dev/enabled: "true"
          gethomepage.dev/icon: sh-loki
          gethomepage.dev/name: Loki
          gethomepage.dev/group: Infrastructure
        hosts:
          - host: &host loki.${SECRET_DOMAIN}
            paths:
              - path: /
                pathType: Prefix

    read:
      replicas: 1

    write:
      replicas: 1
      persistence:
        storageClass: ceph-block
        size: 20Gi

    backend:
      replicas: 1
      persistence:
        storageClass: ceph-block
        size: 20Gi

    monitoring:
      dashboards:
        annotations:
          grafana_folder: Loki
      rules:
        enabled: false
      serviceMonitor:
        enabled: false
        metricsInstance:
          enabled: false
      selfMonitoring:
        enabled: false
        grafanaAgent:
          installOperator: false

    sidecar:
      image:
        repository: ghcr.io/kiwigrid/k8s-sidecar
      rules:
        searchNamespace: ALL
        folder: /rules/fake

    lokiCanary:
      enabled: false

    test:
      enabled: false

  valuesFrom:
    - kind: Secret
      targetPath: loki.structuredConfig.common.storage.s3.bucketnames
      name: *app
      valuesKey: BUCKET_NAME
    - kind: Secret
      targetPath: loki.structuredConfig.common.storage.s3.endpoint
      name: *app
      valuesKey: BUCKET_HOST
    - kind: Secret
      targetPath: loki.structuredConfig.common.storage.s3.access_key_id
      name: *app
      valuesKey: AWS_ACCESS_KEY_ID
    - kind: Secret
      targetPath: loki.structuredConfig.common.storage.s3.secret_access_key
      name: *app
      valuesKey: AWS_SECRET_ACCESS_KEY
