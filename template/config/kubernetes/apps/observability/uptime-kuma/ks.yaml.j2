---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: &app uptime-kuma
spec:
  targetNamespace: observability
  path: ./kubernetes/apps/observability/uptime-kuma/app
  prune: true
  sourceRef:
    kind: GitRepository
    name: flux-system
    namespace: flux-system
  wait: false
  components:
    - ../../../../components/volsync
  postBuild:
    substituteFrom:
      - name: cluster-secrets
        kind: Secret
    substitute:
      APP: *app
      APP_UID: "0"
      APP_GID: "0"
  interval: 30m
  retryInterval: 1m
  timeout: 5m
